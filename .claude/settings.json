{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "args": [
              "-I",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/allow_enqueue.py"
            ],
            "command": "python3",
            "timeout": 15,
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(python3 -I .baseline/baseline.py enqueue *)"
    ],
    "ask": [],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/.env/**)",
      "Read(**/.env.*/**)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Bash(git push * main)",
      "Bash(git push * main *)",
      "Bash(git push *:main)",
      "Bash(git push *:main *)",
      "Bash(git push *refs/heads/main*)",
      "Bash(git push *--force*)",
      "Bash(git push *-f)",
      "Bash(git push *-f *)",
      "Bash(git push * +*)",
      "Bash(git reset *--hard*)",
      "Bash(git clean *)",
      "Bash(gh api *protection*)",
      "Bash(gh api *rulesets*)",
      "Bash(gh api *hooks*)",
      "Bash(gh api *collaborators*)",
      "Bash(gh api *secrets*)",
      "Bash(gh secret *)",
      "Bash(gh repo edit *)",
      "Bash(gh repo delete *)",
      "Bash(gh pr merge *)",
      "Bash(gh api *pulls/*/merge*)",
      "Bash(gh api *mergePullRequest*)",
      "Bash(gh api *enqueuePullRequest*)",
      "Bash(gh api *enablePullRequestAutoMerge*)"
    ]
  }
}
