{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "args": [
              "-I",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/allow_enqueue.py",
              "--sha256",
              "db2d40e03fe1023c7f3b50f1a072508e5f4e2a56afb13d2f58fb88d335bf62da"
            ],
            "command": "python3",
            "timeout": 15,
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "args": [
              "-I",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/check.py"
            ],
            "command": "python3",
            "timeout": 120,
            "type": "command"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [],
    "ask": [],
    "deny": [
      "Read(**/.env*)",
      "Read(**/.env*/**)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Bash(git push * main)",
      "Bash(git push * main *)",
      "Bash(git push *:main)",
      "Bash(git push *:main *)",
      "Bash(git push *refs/heads/main*)",
      "Bash(git push *--force*)",
      "Bash(git push *-f)",
      "Bash(git push *-f *)",
      "Bash(git push * +*)",
      "Bash(git push *--mirror*)",
      "Bash(git push *--all*)",
      "Bash(git reset *--hard*)",
      "Bash(git clean *)",
      "Bash(gh api *protection*)",
      "Bash(gh api *rulesets*)",
      "Bash(gh api *hooks*)",
      "Bash(gh api *collaborators*)",
      "Bash(gh api *secrets*)",
      "Bash(gh api *allow_*merge*)",
      "Bash(gh api *-X DELETE*)",
      "Bash(gh api *-XDELETE*)",
      "Bash(gh api *--method DELETE*)",
      "Bash(gh api *--method=DELETE*)",
      "Bash(gh secret *)",
      "Bash(gh repo edit *)",
      "Bash(gh repo delete *)",
      "Bash(gh pr merge *)",
      "Bash(gh api *pulls/*/merge*)",
      "Bash(gh api *mergePullRequest*)",
      "Bash(gh api *enqueuePullRequest*)",
      "Bash(gh api *enablePullRequestAutoMerge*)",
      "Bash(*baseline.py*github*apply*)"
    ]
  }
}
